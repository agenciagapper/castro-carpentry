# Generated by _build/build.py: edit REDIRECTS_301 / GONE_410 there.
# HTTPS is forced in hPanel (Hostinger), not here, to avoid redirect loops behind the CDN.
Options -Indexes
DirectorySlash On
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# www -> bare domain, one hop
RewriteCond %{HTTP_HOST} ^www\.castrocarpentryinc\.com$ [NC]
RewriteRule ^(.*)$ https://castrocarpentryinc.com/$1 [R=301,L]

# The form endpoint: only browsers may post to it
RewriteCond %{REQUEST_METHOD} POST
RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
RewriteCond %{HTTP_USER_AGENT} (curl|python|wget|libwww|httpclient|go-http|java/|scrapy) [NC]
RewriteRule ^api/ - [F,L]
RewriteRule ^api/(?!lead\.php$) - [F,L]

# WordPress probes (the old site is gone): answer 410 and move on
RewriteRule ^(wp-login\.php|wp-admin|wp-content|wp-includes|wp-config\.php|\.env)(/|$) - [G,L]

# Build sources and repo files are never public
RewriteRule ^(_build|\.git)(/|$) - [F,L]
RewriteRule ^(README\.md|\.gitignore)$ - [F,L]

# WordPress query URLs (?wpr_templates=..., ?p=..., ?page_id=...)
RewriteCond %{QUERY_STRING} (^|&)(wpr_templates|p|page_id)= [NC]
RewriteRule ^$ - [G,L]

# Old WordPress URLs
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(page|post)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^contact/?$ /contact-us/ [R=301,L]
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^financing/?$ /financing-options/ [R=301,L]
RewriteRule ^decks/?$ /decking/ [R=301,L]
RewriteRule ^windows-doors/?$ /windows-and-doors/ [R=301,L]
RewriteRule ^privacy-policy/?$ /terms-of-service-privacy-policy/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^decks\.html$ /decking/ [R=301,L]
RewriteRule ^windows-doors\.html$ /windows-and-doors/ [R=301,L]
RewriteRule ^about\.html$ /about-us/ [R=301,L]
RewriteRule ^contact\.html$ /contact-us/ [R=301,L]
RewriteRule ^financing\.html$ /financing-options/ [R=301,L]
RewriteRule ^(services|trim|siding|roofing|process|reviews|faq|adu)\.html$ /$1/ [R=301,L]
RewriteRule ^hello-world/?$ - [G,L]
RewriteRule ^category/.*$ - [G,L]
RewriteRule ^author/.*$ - [G,L]
RewriteRule ^feed/?$ - [G,L]
RewriteRule ^comments/feed/?$ - [G,L]
RewriteRule ^wp-json/.*$ - [G,L]
RewriteRule ^(wpr_templates|category|author)-sitemap\.xml$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]

# Clean URLs always end in a slash (/trim -> /trim/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(woff2|webp|jpg|png|ico|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
