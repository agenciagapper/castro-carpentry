# Variáveis do servidor. Na Hostinger, cadastre em Node.js > Variáveis de ambiente.
# Localmente, copie para .env (o .env não vai para o Git).

NODE_ENV=production

# Pasta do banco SQLite e das imagens enviadas pelo painel. Deve ficar FORA da pasta do app,
# para não ser apagada a cada deploy. Ex.: /home/u123456789/castro-data
DATA_DIR=

# Endereço público do site (https, sem barra no fim). Usado nos links de convite e de nova senha
# e como endereço do MCP e do OAuth: se estiver errado, o Claude e o ChatGPT não conseguem conectar.
PUBLIC_URL=https://castrocarpentryinc.com

# Primeiro acesso: cria o membro inicial se o banco estiver vazio.
# Depois do primeiro login, apague ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# E-mail (opcional). Sem isso, convites e links de nova senha aparecem no painel para copiar.
# Hostinger: smtp.hostinger.com, porta 465, com uma conta de e-mail do domínio.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
